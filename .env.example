CLIPATLAS_ENABLE_FAKE_PROVIDER=false
CLIPATLAS_VIDEO_ROOT=./data/videos
CLIPATLAS_PROJECT_DB=./data/projects/projects.sqlite3
CLIPATLAS_SETTINGS_FILE=./data/config/settings.json

CLIPATLAS_LIBRARY_DB=./data/library/library.sqlite3
CLIPATLAS_LIBRARY_CACHE_ROOT=./data/library-cache
CLIPATLAS_LIBRARY_SCAN_INTERVAL_SECONDS=60
# Library parsing starts paused. Resume unfinished items explicitly in the UI.
CLIPATLAS_VISUAL_CONCURRENCY=4
CLIPATLAS_ASR_CONCURRENCY=3
CLIPATLAS_OCR_CONCURRENCY=6
CLIPATLAS_LIBRARY_FFMPEG_CONCURRENCY=1
DASHSCOPE_RPM=180
CLIPATLAS_ASR_RPM=60
CLIPATLAS_OCR_RPM=240
CLIPATLAS_LIBRARY_PROVIDER=qwen

# Primary non-TTS AI configuration: one Bailian key + one Workspace/Base URL.
CLIPATLAS_BAILIAN_API_KEY=
CLIPATLAS_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Legacy compatibility only. New deployments should use CLIPATLAS_BAILIAN_* above.
CLIPATLAS_QWEN_API_KEY=
CLIPATLAS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLIPATLAS_QWEN_DEFAULT_MODEL=qwen3.8-flash
CLIPATLAS_QWEN_LONG_CONTEXT_MODEL=qwen3.8-flash

# Legacy compatibility only. Existing 1024-dimension text embeddings remain isolated.
CLIPATLAS_EMBEDDING_API_KEY=
CLIPATLAS_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLIPATLAS_EMBEDDING_MODEL=text-embedding-v4
CLIPATLAS_EMBEDDING_DIMENSIONS=1024

CLIPATLAS_NARRATION_ROOT=./data/narration
CLIPATLAS_ENABLE_FAKE_SPEECH_PROVIDER=false
CLIPATLAS_SPEECH_PROVIDER=
CLIPATLAS_SPEECH_API_KEY=
CLIPATLAS_SPEECH_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
CLIPATLAS_SPEECH_MODEL=cosyvoice-v3.5-flash
CLIPATLAS_SPEECH_WORKSPACE_ID=

CLIPATLAS_ROUGHCUT_DB=./data/roughcut.sqlite3

CLIPATLAS_EXPORT_ROOT=./data/exports
CLIPATLAS_JIANYING_DRAFT_ROOT=
CLIPATLAS_JIANYING_INSTALL_DIR=
CLIPATLAS_JIANYING_USER_DATA=
CLIPATLAS_JIANYING_MODE=portable
CLIPATLAS_JIANYING_EXECUTABLE=

TWELVELABS_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
